{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project.spec.schema.json",
  "title": "Idea spec",
  "description": "A blurry idea written down clearly, produced by /grill-me. Each fact has one home: glossary = what words mean, features = what it does, flows = how it plays out, decisions = settled, assumptions = guesses, openQuestions = not figured out yet ('not sure' lives only there).",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "title", "idea", "glossary", "features", "flows", "examples", "leftOut", "decisions", "assumptions", "openQuestions"],
  "properties": {
    "$schema": { "type": "string" },
    "status": { "enum": ["draft", "clear"], "description": "draft = still clarifying; clear = the user agrees this captures what they mean." },
    "title": { "$ref": "#/$defs/text", "description": "Working title." },
    "idea": { "$ref": "#/$defs/text", "description": "The idea in one sentence." },
    "glossary": {
      "type": "array", "minItems": 1,
      "description": "The words the user uses and exactly what they mean in this idea.",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["term", "meaning"],
        "properties": {
          "term": { "$ref": "#/$defs/text" },
          "meaning": { "$ref": "#/$defs/text" }
        }
      }
    },
    "features": {
      "type": "array", "minItems": 1,
      "description": "The parts of the thing and what each one does.",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "whatItDoes", "details"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "$ref": "#/$defs/text" },
          "whatItDoes": { "$ref": "#/$defs/text" },
          "details": { "type": "array", "items": { "$ref": "#/$defs/text" }, "description": "Specific behaviours: inputs, outputs, rules, what it looks like." }
        }
      }
    },
    "flows": {
      "type": "array",
      "description": "Step-by-step: what happens, in order, when someone uses it.",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "steps"],
        "properties": {
          "name": { "$ref": "#/$defs/text" },
          "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } }
        }
      }
    },
    "examples": {
      "type": "array",
      "description": "Concrete situations and what the thing does in each.",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["situation", "whatHappens"],
        "properties": {
          "situation": { "$ref": "#/$defs/text" },
          "whatHappens": { "$ref": "#/$defs/text" }
        }
      }
    },
    "leftOut": { "type": "array", "items": { "$ref": "#/$defs/text" }, "description": "Things it deliberately does not do (or not yet)." },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "decision", "date"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "decision": { "$ref": "#/$defs/text" },
          "reason": { "$ref": "#/$defs/text" },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["statement"],
        "properties": { "statement": { "$ref": "#/$defs/text" } }
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["question"],
        "properties": { "question": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Z]+-\\d+$", "description": "e.g. F-1, D-2" },
    "text": {
      "type": "string", "minLength": 1,
      "pattern": "^(?![\\s\\S]*\\b([Tt][Bb][Dd]|TODO|[Uu]nknown|[Nn]ot sure)\\b)[\\s\\S]*\\S[\\s\\S]*$",
      "description": "Concrete text. Anything not figured out yet goes in openQuestions, never here."
    }
  }
}
